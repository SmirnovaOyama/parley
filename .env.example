# Copy to .env (or run `npm run setup`, which writes KEY_ENCRYPTION_SECRET for you).

# Encrypts the AI API keys stored in the database. At least 32 random characters.
# Never change it once keys are saved, or they can't be read any more.
KEY_ENCRYPTION_SECRET=

# The site's name: the wordmark in the sidebar and the browser tab title.
VITE_APP_NAME=Parley

# Where the SQLite database lives (default data/chat.db).
# DATABASE_PATH=data/chat.db

# Port for the API server (default 8787). In production it also serves the built site.
# In development (npm run dev) the API stays on 8787 and the page server on 5173; set API_PORT
# or PORT in the shell, not here, to move them.
# PORT=8787

# Outgoing email, for password reset links and the optional address check that earns a reward
# (Admin → Settings → Email rewards). Without it, links and codes are printed in the server log
# during development, and both are off in production.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Chat <no-reply@example.com>"

# The address people reach the site at. Password reset emails link here, so resetting a forgotten
# password by email needs it (and SMTP_URL). MCP servers that people sign in to send them back here
# too; for those, without it, the address in the browser is used, which is right unless a proxy in
# front changes it.
# PUBLIC_URL=https://chat.example.com

# Set to 1 only if the server reaches the internet through a proxy that answers every name with a
# 198.18.x.x stand-in address (Clash, Surge, sing-box and the like in fake-IP mode). Without it, the
# page reader for other models' web search refuses those addresses: behind such a proxy it can't
# check where a name really leads, so a name pointing inside your network would be read too.
# ALLOW_FAKE_IP=1
