{
  "name": "parley",
  "version": "0.1.1",
  "description": "A self-hosted AI chat site for teams: Claude, OpenAI, Gemini, Grok, DeepSeek and any OpenAI-compatible service, with shared API keys, limits and usage",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmirnovaOyama/parley.git"
  },
  "bugs": "https://github.com/SmirnovaOyama/parley/issues",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c auto \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/dev-api.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --test --test-timeout=30000 \"test/**/*.test.ts\"",
    "setup": "node scripts/setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "nodemailer": "10.0.15",
    "openai": "^7.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "undici": "^8.11.2",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
