# Copy to .env (or run `npm run setup`, which writes KEY_ENCRYPTION_SECRET for you).

# Encrypts the AI API keys stored in the database. At least 32 random characters.
# Never change it once keys are saved, or they can't be read any more.
KEY_ENCRYPTION_SECRET=

# The site's name: the wordmark in the sidebar and the browser tab title.
VITE_APP_NAME=Parley

# Where the SQLite database lives (default data/chat.db).
# DATABASE_PATH=data/chat.db

# Port for the API server (default 8787). In production it also serves the built site.
# In development (npm run dev) the API stays on 8787 and the page server on 5173; set API_PORT
# or PORT in the shell, not here, to move them.
# PORT=8787

# Outgoing email, for the optional address check that earns a reward (Admin → Settings →
# Email rewards). Without it, codes are printed in the server log during development, and the
# check is off in production.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Chat <no-reply@example.com>"
